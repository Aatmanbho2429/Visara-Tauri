# Claude
/.claude

# Angular cache & build
UI/.angular/
UI/dist/

# Node
UI/node_modules/

# Rust build
UI/src-tauri/target/

# Python
python/__pycache__/
python/**/__pycache__/
*.pyc
*.pyo
*.pyd
python/.venv/
python/venv/
*.onnx.enc
# Allow the bundled model inside the Tauri resources folder (tracked via Git LFS)
!UI/src-tauri/resources/models/*.onnx.enc
# The DINO model now lives with the sidecar that decrypts it. Tracked via Git
# LFS (see .gitattributes) because the release workflow bundles it into the
# frozen sidecar and has no other way to obtain it.
!sidecar/*.onnx.enc
index.faiss
meta.db
# OS
.DS_Store
Thumbs.db

# Env
.env
.env.*

# Logs (sidecar/logs/sidecar.log; Rust side logs to %APPDATA%, outside the repo)
sidecar/logs/
*.log
