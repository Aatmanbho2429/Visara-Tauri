{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Pictoria",
  "version": "1.1.32",
  "identifier": "com.pictoria.app",
  "build": {
    "frontendDist": "../dist/UI/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npm start",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Pictoria",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope":  ["**", "**/.pictoria/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/pictoria-sidecar"
    ],
    "macOS": {
      "entitlements": "entitlements.plist"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVEMDhGRDc3ODJDQzk5MTAKUldRUW1jeUNkLzBJN2J1bEZnd2hIRTBodnVEN1E4MG1FdDcwV3hPVVBrSXNzWEJzcEFNMEdpeW8K",
      "endpoints": [
        "https://github.com/Aatmanbho2429/Visara-Tauri/releases/latest/download/latest.json"
      ],
      "dialog": false
    }
  }
}
